 "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Fira+Code:wght@500;600&display=swap\");\n    .print-format {\n        padding: 0px !important;\n    }\n    @page {\n        margin: 0;\n        size: 100mm 50mm;\n    }\n    body {\n        margin: 0;\n        padding: 0;\n        width: 100mm;\n        height: 50mm;\n        font-family: Arial, sans-serif;\n        color: #000;\n        background-color: #fff;\n    }\n    .sticker-container {\n        padding: 4mm;\n        box-sizing: border-box;\n        width: 100%;\n        height: 100%;\n        display: flex;\n        flex-direction: column;\n        justify-content: flex-start;\n    }\n    .title {\n        font-size: 26px;\n        font-weight: 900;\n        text-align: center;\n        border-bottom: 3px solid #000;\n        padding-bottom: 4px;\n        margin-bottom: 6px;\n        text-transform: uppercase;\n    }\n    .data-table {\n        width: 100%;\n        font-size: 18px;\n        line-height: 1.6;\n        margin-bottom: 8px;\n        font-family: 'Fira Code', monospace;\n        font-weight: 500;\n    }\n    .data-table td {\n        vertical-align: top;\n    }\n    .label {\n        font-weight: bold;\n        width: 40%;\n    }\n    .barcode-container {\n        text-align: center;\n        margin-top: auto;\n    }\n    .barcode {\n        width: 90%;\n        height: 12mm;\n    }\n</style>\n\n<div class=\"sticker-container\">\n    <div class=\"title\">{{ frappe.db.get_value(\"Item\", doc.strip_product_code, \"item_name\") or doc.strip_product_code }}</div>\n    <table class=\"data-table\">\n        <tr>\n            <td class=\"label\">Strip Width:</td>\n            <td>{{ doc.actual_strip_width or 0 }} mm</td>\n        </tr>\n        <tr>\n            <td class=\"label\">Batch No:</td>\n            <td>{{ doc.strip_work_schedule }}</td>\n        </tr>\n        <tr>\n            <td class=\"label\">Roll No:</td>\n            <td>{{ doc.name }}</td>\n        </tr>\n    </table>\n    \n    <div class=\"barcode-container\">\n        <svg class=\"barcode\" data-barcode-value=\"{{ doc.name }}\"></svg>\n    </div>\n</div>\n<script>\n    setTimeout(function() {\n        if (typeof JsBarcode !== 'undefined') {\n            JsBarcode(\".barcode\").init({font: \"Fira Code\", fontWeight: \"600\"});\n        }\n    }, 500);\n</script>\n",
