 "html": "<style>\n    .print-format {\n        padding: 0px !important;\n    }\n    @page {\n        margin: 0;\n        size: 100mm 50mm;\n    }\n    body {\n        margin: 0;\n        padding: 0;\n        width: 100mm;\n        height: 50mm;\n        font-family: Arial, sans-serif;\n        color: #000;\n        background-color: #fff;\n    }\n    .sticker-container {\n        padding: 4mm 5mm; \n        box-sizing: border-box;\n        width: 100mm;\n        height: 50mm;\n        overflow: hidden;\n    }\n    .data-table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n    .data-table td {\n        vertical-align: top;\n        border: none !important;\n        padding: 2px 0px !important;\n        font-size: 13px !important;\n        font-weight: 700 !important;\n        line-height: 1.2 !important;\n        color: #000 !important;\n    }\n    .lbl-col {\n        width: 32%;\n        text-align: left;\n    }\n    .colon-col {\n        width: 3%;\n        text-align: center;\n    }\n    .val-col {\n        width: 65%;\n        text-align: left;\n    }\n</style>\n\n<div class=\"sticker-container\">\n    <table class=\"data-table\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n        <tr>\n            <td class=\"lbl-col\">Product Name</td>\n            <td class=\"colon-col\">:</td>\n            <td class=\"val-col\">{{ frappe.db.get_value(\"Item\", doc.strip_product_code, \"item_name\") or doc.strip_product_code }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl-col\">Roll Length</td>\n            <td class=\"colon-col\">:</td>\n            <td class=\"val-col\">{{ doc.roll_length or 0 }} Linear Meter</td>\n        </tr>\n        <tr>\n            <td class=\"lbl-col\">Batch No.</td>\n            <td class=\"colon-col\">:</td>\n            <td class=\"val-col\">{{ doc.strip_work_schedule }}</td>\n        </tr>\n        <tr>\n            <td class=\"lbl-col\" style=\"padding-top: 3px !important;\">Roll No.</td>\n            <td class=\"colon-col\" style=\"padding-top: 3px !important;\">:</td>\n            <td class=\"val-col\" style=\"padding-top: 3px !important;\">\n                <div style=\"text-align: center; width: fit-content;\">\n                    <img src=\"https://barcode.tec-it.com/barcode.ashx?data={{ doc.name }}&code=Code128&dpi=96&hidehrt=True\" style=\"height: 9mm; max-width: 100%; object-fit: contain; display: block; margin: 0 auto;\" />\n                    <div style=\"font-size: 13px; font-weight: 900; letter-spacing: 0.5px; margin-top: 2px;\">{{ doc.name }}</div>\n                </div>\n            </td>\n        </tr>\n    </table>\n</div>",
