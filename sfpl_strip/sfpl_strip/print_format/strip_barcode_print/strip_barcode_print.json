 "html": "<style>\n    .print-format {\n        padding: 0px !important;\n    }\n    @page {\n        margin: 0;\n        size: 100mm 50mm;\n    }\n    body {\n        margin: 0;\n        padding: 0;\n        width: 100mm;\n        height: 50mm;\n        font-family: Arial, sans-serif;\n        color: #000;\n        background-color: #fff;\n    }\n    .sheet {\n        margin: 0;\n        padding: 0;\n        width: 100mm;\n        height: 50mm;\n        background-color: #fff;\n        color: #000;\n        display: flex;\n        flex-direction: row;\n        overflow: hidden;\n    }\n    .sticker {\n        width: 50mm;\n        height: 50mm;\n        box-sizing: border-box;\n        padding: 2.5mm 3.5mm 3mm 3.5mm;\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n        overflow: hidden;\n        position: relative;\n    }\n    .product-title {\n        font-size: 11.5px;\n        font-weight: 900;\n        line-height: 1.15;\n        text-transform: uppercase;\n        color: #000;\n        text-align: center;\n        border-bottom: 1.5px solid #000;\n        padding-bottom: 2.5px;\n        margin: 0 0 4px 0;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n    }\n    .info-tbl {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 0;\n    }\n    .info-tbl td {\n        vertical-align: top;\n        border: none !important;\n        padding: 2px 0px !important;\n        font-size: 10.5px !important;\n        font-weight: 700 !important;\n        line-height: 1.3 !important;\n        color: #000 !important;\n    }\n    .lbl {\n        width: 35%;\n        text-align: left;\n    }\n    .sep {\n        width: 6%;\n        text-align: center;\n    }\n    .val {\n        width: 59%;\n        text-align: left;\n    }\n    .barcode-section {\n        text-align: center;\n        margin-top: auto;\n        padding-top: 3px;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        width: 100%;\n    }\n    .barcode-img {\n        height: 16.5mm;\n        max-width: 96%;\n        object-fit: contain;\n        display: block;\n        margin: 0 auto;\n    }\n</style>\n\n<div class=\"sheet\">\n    <!-- STICKER #1 (LEFT - INNER CORE) -->\n    <div class=\"sticker\">\n        <div>\n            <div class=\"product-title\">{{ frappe.db.get_value(\"Item\", doc.strip_product_code, \"item_name\") or doc.strip_product_code }}</div>\n            <table class=\"info-tbl\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                    <td class=\"lbl\">Length</td>\n                    <td class=\"sep\">:</td>\n                    <td class=\"val\">{{ doc.roll_length or 0 }} Meter</td>\n                </tr>\n                <tr>\n                    <td class=\"lbl\">Batch No.</td>\n                    <td class=\"sep\">:</td>\n                    <td class=\"val\">{{ doc.strip_work_schedule }}</td>\n                </tr>\n                <tr>\n                    <td class=\"lbl\">Roll No.</td>\n                    <td class=\"sep\">:</td>\n                    <td class=\"val\">{{ doc.name }}</td>\n                </tr>\n            </table>\n        </div>\n        <div class=\"barcode-section\">\n            <img class=\"barcode-img\" src=\"https://barcode.tec-it.com/barcode.ashx?data={{ doc.name }}&code=PDF417&dpi=150&height=25&hidehrt=True\" alt=\"PDF417 Barcode\" />\n        </div>\n    </div>\n\n    <!-- STICKER #2 (RIGHT - OUTER FILM WRAP) -->\n    <div class=\"sticker\">\n        <div>\n            <div class=\"product-title\">{{ frappe.db.get_value(\"Item\", doc.strip_product_code, \"item_name\") or doc.strip_product_code }}</div>\n            <table class=\"info-tbl\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                    <td class=\"lbl\">Length</td>\n                    <td class=\"sep\">:</td>\n                    <td class=\"val\">{{ doc.roll_length or 0 }} Meter</td>\n                </tr>\n                <tr>\n                    <td class=\"lbl\">Batch No.</td>\n                    <td class=\"sep\">:</td>\n                    <td class=\"val\">{{ doc.strip_work_schedule }}</td>\n                </tr>\n                <tr>\n                    <td class=\"lbl\">Roll No.</td>\n                    <td class=\"sep\">:</td>\n                    <td class=\"val\">{{ doc.name }}</td>\n                </tr>\n            </table>\n        </div>\n        <div class=\"barcode-section\">\n            <img class=\"barcode-img\" src=\"https://barcode.tec-it.com/barcode.ashx?data={{ doc.name }}&code=PDF417&dpi=150&height=25&hidehrt=True\" alt=\"PDF417 Barcode\" />\n        </div>\n    </div>\n</div>",
