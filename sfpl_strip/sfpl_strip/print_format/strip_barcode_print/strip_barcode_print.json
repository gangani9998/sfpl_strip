 "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Fira+Code:wght@500;600&display=swap\");\n    .print-format {\n        padding: 0px !important;\n    }\n    @page {\n        margin: 0;\n        size: 100mm 50mm;\n    }\n    body {\n        margin: 0;\n        padding: 0;\n        width: 100mm;\n        height: 50mm;\n        font-family: Arial, sans-serif;\n        color: #000;\n        background-color: #fff;\n    }\n    .sheet {\n        margin: 0;\n        padding: 0;\n        width: 100mm;\n        height: 50mm;\n        background-color: #fff;\n        color: #000;\n        display: flex;\n        flex-direction: row;\n        overflow: hidden;\n    }\n    .sticker {\n        width: 50mm;\n        height: 50mm;\n        box-sizing: border-box;\n        padding: 4.5mm 2.5mm 2.5mm 2.5mm;\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n        overflow: hidden;\n        position: relative;\n    }\n    .header-block {\n        border-bottom: 2px solid #000;\n        padding-bottom: 2.5px;\n        margin-bottom: 1.5px;\n        text-align: center;\n    }\n    .prod-type {\n        font-size: 11.5px;\n        font-weight: 700;\n        text-transform: none;\n        letter-spacing: 0.5px;\n        color: #000;\n        margin-bottom: 2.5px;\n        line-height: 1.15;\n    }\n    .item-name {\n        font-size: 14.5px;\n        font-weight: 900;\n        color: #000;\n        line-height: 1.15;\n        display: -webkit-box;\n        -webkit-line-clamp: 2;\n        -webkit-box-orient: vertical;\n        overflow: hidden;\n        word-break: break-word;\n    }\n    .info-tbl {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 0;\n    }\n    .info-tbl td {\n        vertical-align: top;\n        border: none !important;\n        padding: 1px 0px !important;\n        font-size: 12.5px !important;\n        font-weight: 700 !important;\n        line-height: 1.2 !important;\n        color: #000 !important;\n    }\n    .lbl {\n        width: 35%;\n        text-align: left;\n    }\n    .sep {\n        width: 6%;\n        text-align: center;\n    }\n    .val {\n        width: 59%;\n        text-align: left;\n        font-family: \"Fira Code\", monospace;\n        font-weight: 500 !important;\n        letter-spacing: 0.8px;\n    }\n    .barcode-section {\n        text-align: center;\n        margin-top: auto;\n        padding-bottom: 2.3mm;\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n        align-items: center;\n        width: 100%;\n    }\n    .barcode-header {\n        font-size: 12.5px;\n        font-weight: 700;\n        color: #000;\n        margin-bottom: 2px;\n        line-height: 1.1;\n    }\n    .barcode-img {\n        height: 14mm;\n        max-width: 96%;\n        object-fit: contain;\n        display: block;\n        margin: 0 auto;\n        image-rendering: pixelated;\n        image-rendering: -moz-crisp-edges;\n        image-rendering: crisp-edges;\n    }\n    .barcode-footer {\n        font-family: \"Fira Code\", monospace;\n        font-size: 16.5px;\n        font-weight: 600;\n        letter-spacing: 2.0px;\n        color: #000;\n        margin-top: 3px;\n        line-height: 1;\n    }\n</style>\n\n<div class=\"sheet\">\n    <!-- STICKER #1 (LEFT - INNER CORE) -->\n    <div class=\"sticker\">\n        <div>\n            <div class=\"header-block\">\n                <div class=\"prod-type\">{{ frappe.db.get_value(\"Item\", doc.strip_product_code, \"custom_product_type\") or frappe.db.get_value(\"Item\", doc.strip_product_code, \"item_group\") or \"\" }}</div>\n                <div class=\"item-name\">{{ frappe.db.get_value(\"Item\", doc.strip_product_code, \"product_code\") or frappe.db.get_value(\"Item\", doc.strip_product_code, \"item_name\") or doc.strip_product_code }}</div>\n            </div>\n            <table class=\"info-tbl\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                    <td class=\"lbl\">Length</td>\n                    <td class=\"sep\">:</td>\n                    <td class=\"val\">{{ doc.roll_length or 0 }} <span style=\"font-family: Arial, sans-serif !important;\">Meter</span></td>\n                </tr>\n                <tr>\n                    <td class=\"lbl\">Batch No.</td>\n                    <td class=\"sep\">:</td>\n                    <td class=\"val\">{{ doc.strip_work_schedule }}</td>\n                </tr>\n            </table>\n        </div>\n        <div class=\"barcode-section\">\n            <div class=\"barcode-header\">Roll Number</div>\n            <img class=\"barcode-img\" src=\"https://barcode.tec-it.com/barcode.ashx?data={{ doc.name }}&code=Code128&dpi=203&height=20&hidehrt=True\" alt=\"Code128 Barcode\" />\n            <div class=\"barcode-footer\">{{ doc.name }}</div>\n        </div>\n    </div>\n\n    <!-- STICKER #2 (RIGHT - OUTER FILM WRAP) -->\n    <div class=\"sticker\">\n        <div>\n            <div class=\"header-block\">\n                <div class=\"prod-type\">{{ frappe.db.get_value(\"Item\", doc.strip_product_code, \"custom_product_type\") or frappe.db.get_value(\"Item\", doc.strip_product_code, \"item_group\") or \"\" }}</div>\n                <div class=\"item-name\">{{ frappe.db.get_value(\"Item\", doc.strip_product_code, \"product_code\") or frappe.db.get_value(\"Item\", doc.strip_product_code, \"item_name\") or doc.strip_product_code }}</div>\n            </div>\n            <table class=\"info-tbl\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                    <td class=\"lbl\">Length</td>\n                    <td class=\"sep\">:</td>\n                    <td class=\"val\">{{ doc.roll_length or 0 }} <span style=\"font-family: Arial, sans-serif !important;\">Meter</span></td>\n                </tr>\n                <tr>\n                    <td class=\"lbl\">Batch No.</td>\n                    <td class=\"sep\">:</td>\n                    <td class=\"val\">{{ doc.strip_work_schedule }}</td>\n                </tr>\n            </table>\n        </div>\n        <div class=\"barcode-section\">\n            <div class=\"barcode-header\">Roll Number</div>\n            <img class=\"barcode-img\" src=\"https://barcode.tec-it.com/barcode.ashx?data={{ doc.name }}&code=Code128&dpi=203&height=20&hidehrt=True\" alt=\"Code128 Barcode\" />\n            <div class=\"barcode-footer\">{{ doc.name }}</div>\n        </div>\n    </div>\n</div>",
